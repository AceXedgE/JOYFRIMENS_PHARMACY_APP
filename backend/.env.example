# Set variables in your shell; this example is not automatically loaded.
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173
# Without DATABASE_URL, development uses backend/.data (embedded PostgreSQL).
# Production requires DATABASE_URL and HTTPS APP_ORIGINS. Use deployment secrets.
# DATABASE_URL=postgresql://user:password@localhost:5432/joyfrimens
# PGLITE_DIR=an-absolute-local-development-path
SHOP_1_NAME=Tomjoy Pharmacy
SHOP_2_NAME=Joyfrimens Pharmacy
SHOP_CURRENCY=GHS
SHOP_TIMEZONE=Etc/GMT
# Required only when running db:bootstrap; never commit actual credentials.
# BOOTSTRAP_USERNAME=your.admin
# BOOTSTRAP_PASSWORD=provide-a-unique-secret-through-your-environment
# BOOTSTRAP_NAME=Administrator
