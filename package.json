{
  "name": "joyfrimens",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w backend",
    "smoke": "node scripts/smoke.mjs",
    "test:e2e": "playwright test",
    "setup:dev": "npm run setup:dev -w backend",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke"
  },
  "devDependencies": {
    "@electric-sql/pglite-tools": "^0.4.13",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
