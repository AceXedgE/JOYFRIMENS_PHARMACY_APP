{
  "name": "joyfrimens", "version": "0.1.0", "private": true,
  "workspaces": ["frontend", "backend"],
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w backend",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke"
  },
  "devDependencies": { "concurrently": "^9.2.1", "typescript": "^5.9.3", "@types/node": "^24.10.0" }
}
